[rendering]

; Desktop stays on Forward+. A Godot 4 web export cannot use it — the browser
; target only supports the Compatibility (OpenGL/WebGL2) backend, and a Forward+
; build exports cleanly but then fails to start in the browser, so the breakage
; only ever surfaces on itch.io. The per-platform override keeps the desktop
; build byte-identical while giving the web build a backend it can actually run.
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
