; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Gather"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameItems="*res://items/items.gd"
GameSoundManager="*res://systems/sound_manager.gd"
Recipes="*res://crafting/recipes.gd"
PlayerManager="*res://player/player_manager.gd"
PickUpManager="*res://items/pick_up_manager.gd"
DevTools="*res://addons/godot_selftest/dev_tools.gd"

[display]

; A bigger window, deliberately with stretch disabled: the viewport grows with the
; window instead of being scaled up, so sprites keep their exact pixel size and the
; extra window area becomes extra visible world. Every HUD element is anchored to a
; viewport edge (UI2 CanvasLayer) or to the camera's visible world rect
; (Player/Camera2D/UI, sized by ui/camera_hud.gd), so these numbers are a starting
; size and not a layout the UI depends on.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="disabled"

[dotnet]

project/assembly_name="Gather"

[editor_plugins]

; The virtual joystick behind ui/mobile_controls.tscn. The overlay instances
; addons/virtual_joystick/virtual_joystick_scene.tscn directly, so the game does
; not need the plugin enabled to run. This is only so the editor registers the
; custom type and the addon stops showing up as disabled.
enabled=PackedStringArray("res://addons/virtual_joystick/plugin.cfg")

