; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Gather"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameItems="*res://items/items.gd"
GameSoundManager="*res://systems/sound_manager.gd"
Recipes="*res://crafting/recipes.gd"
PlayerManager="*res://player/player_manager.gd"
PickUpManager="*res://items/pick_up_manager.gd"
DevTools="*res://addons/godot_selftest/dev_tools.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[dotnet]

project/assembly_name="Gather"

[editor_plugins]

enabled=PackedStringArray("res://addons/virtual_joystick/plugin.cfg")

[gui]

; The project-wide default font. Set here rather than through per-node
; add_theme_font_override calls because the game ships no Theme resource, so
; every Control that nobody styled explicitly — and there are a lot of them —
; falls through to this one. Changing it here repaints all of them at once.
;
; It is a 5x7 bitmap face on a 100-unit pixel grid (see tools/make_pixel_font.py),
; so it is only crisp at font sizes that are whole multiples of 10. That is what
; UiTheme.scaled_font() exists to guarantee.
; NOTE the key is `theme/custom_font`, not `gui/theme/custom_font` — the section
; header supplies the `gui/` prefix. Writing the full name here parses fine, sets
; `gui/gui/theme/custom_font`, and leaves the real setting empty, so the whole game
; silently keeps rendering in Open Sans and nothing anywhere reports a problem.
theme/custom_font="res://assets/fonts/gather_arcade.ttf"

