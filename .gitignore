# Godot 4+ specific ignores
.godot/

# Visual Studio workspace state. Per-machine editor scratch (content indexes,
# solution user options, a sqlite workspace cache) that was committed by
# accident -- ~2.7 MB of churn that means nothing to anyone else.
.vs/

# Export output. The built game is regenerated on every export and goes stale
# the moment a script changes, so it does not belong in history.
bin/
*.exe
*.pck
*.zip

# Editor scratch. Godot writes these while saving a scene or resource
# (maiXXXX.tmp next to main.tscn, WorXXXX.tmp next to World.tscn, and so on)
# and does not always clean them up.
*.tmp

# Backup copies. /scaffold-godot-harness leaves tools/*.bak behind when it
# refreshes the harness; three of them were committed by accident and had already
# drifted hundreds of lines from the live files they shadowed.
*.bak

# Runtime save state, written by SaveLoad.gd during play.
saveFile
saveFile*

# Screenshots captured by the devtools bridge
screenshots/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Agent worktrees. `git worktree add` under .claude/ leaves a nested checkout here;
# it is not ignored by default, so `git add .` would try to commit a second copy of
# the whole project (and the project linter scans it too).
.claude/worktrees/

# /verify scratch. These are the INPUTS to a verify run - two scene-tree snapshots and
# the run row handed to verify_ledger.py - not records of it. The record is
# .devtools/verify-runs.jsonl, which IS committed. Ignored because a run that ends early
# leaves them behind and they then read as untracked work.
.devtools/tree-*.json
.devtools/run.json

# Per-run stdout/stderr from `devtools.py launch`. Overwritten on every launch, so they
# only ever describe the last run on this machine.
.devtools/launch_stdout.log
.devtools/launch_stderr.log
